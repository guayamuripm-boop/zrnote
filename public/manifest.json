{
  "name": "ZRNote — Minutas Inteligentes",
  "short_name": "ZRNote",
  "description": "Graba tus reuniones, transcríbelas y obtén la minuta con los compromisos automáticamente.",
  "id": "/dashboard",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f8fafc",
  "theme_color": "#2563eb",
  "lang": "es",
  "dir": "ltr",
  "categories": ["productivity", "business"],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Grabar ahora",
      "short_name": "Grabar",
      "description": "Crear una reunión y empezar a grabar",
      "url": "/dashboard/meetings/new"
    },
    {
      "name": "Subir audio grabado",
      "short_name": "Subir audio",
      "description": "Sube un audio grabado con la app del teléfono",
      "url": "/dashboard/meetings/new?action=upload"
    },
    {
      "name": "Mis compromisos",
      "short_name": "Compromisos",
      "url": "/dashboard/action-items"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/*",
            "video/mp4",
            "video/quicktime",
            ".mp3",
            ".m4a",
            ".wav",
            ".mp4",
            ".aac",
            ".ogg",
            ".webm",
            ".opus",
            ".flac"
          ]
        }
      ]
    }
  }
}
